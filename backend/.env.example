# Copy to backend/.env. Unknown keys are ignored. NEVER commit the real file.

ENVIRONMENT=development
FACILITY_ID=ED-MAIN

# Local: SQLite. Deployed: Neon Postgres connection string (keep ?sslmode=require).
DATABASE_URL=sqlite:///./triage.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# --- auth (required, >= 32 chars, in staging/production)
# JWT_SECRET=
# Password for the seeded demo accounts (rivera, lee, patel, admin, viewer, okoye). Dev default: demo-password-1
# DEMO_USER_PASSWORD=

# --- LLM (leave blank to run on rules + ML only). A gsk_... key routes to Groq.
OPENAI_API_KEY=
LLM_ENABLED=true
# LLM_MODEL=
# Local model instead of a hosted one (no BAA needed): LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=
# Optional second provider tried if the first fails:
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
LLM_TIMEOUT_SECONDS=10
# Circuit breaker (docs/runbook.md, incident 3): skip a provider after N consecutive failed calls, for the cooldown.
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SECONDS=30
# Only set after a signed BAA with the hosted provider (see docs/PHI_POLICY.md). Blocks hosted LLMs in staging/production when false.
LLM_HOSTED_BAA_CONFIRMED=false

# JSON list. On Render, set to your frontend URL and set CORS_ORIGIN_REGEX= (empty).
# CORS_ORIGINS=["https://your-frontend.onrender.com"]
# CORS_ORIGIN_REGEX=

SEED_ON_STARTUP=true
SEED_DEMO_USERS=true
SEED_DEMO_QUEUE=true
DEMO_MODE=true
DETERIORATION_MONITOR_ENABLED=true
# >1 makes reassessment alerts fire sooner in demos (10 = ESI 2 alerts after 1.5 min)
MONITOR_SPEEDUP=1

# --- document ingestion (Phase 3). See docs/INGESTION.md
MAX_UPLOAD_MB=10
# local disk is wiped on Render free redeploys; use an S3-compatible bucket (R2/B2) for durable originals
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=
# sql = vectors in the main DB (persistent on Neon). chroma = needs a persistent disk.
VECTOR_BACKEND=sql
# Benchmark winner (docs/RETRIEVAL_RESULTS.md). hash-v2 = offline lexical fallback.
EMBEDDING_MODEL=fastembed:minishlab/potion-retrieval-32M
# Render build command: pip install -r backend/requirements.txt && python -m backend.app.retrieval.models --prefetch
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   (off by default: lowered nDCG in the benchmark)
RETRIEVAL_MODE=hybrid
RETRIEVAL_QUERY_EXPANSION=true
INGESTION_WORKER_ENABLED=true
# CLAMAV_HOST=

# --- multimodal intake (Phase 6). Needs: pip install -r backend/requirements-multimodal.txt. See docs/MULTIMODAL.md
# On Render free (512 MB) set both to none: dictation falls back to the browser, scanned uploads are rejected clearly.
STT_ENGINE=faster-whisper
STT_MODEL=tiny.en
STT_LANGUAGE=en
STT_MIN_WORD_CONFIDENCE=0.6
OCR_ENGINE=rapidocr
OCR_MIN_LINE_CONFIDENCE=0.85
OCR_MIN_FIELD_CONFIDENCE=0.85
DATE_ORDER=MDY
